# bashrc — fallback shell; zsh is the daily driver (see Shell/zsh/).
[[ $- != *i* ]] && return

PS1='\[\033[01;32m\][\u@\h\[\033[01;37m\] \W\[\033[01;32m\]]\$\[\033[00m\] '
HISTCONTROL=ignoreboth
HISTSIZE=99999
HISTFILESIZE=99999
shopt -s checkwinsize expand_aliases histappend

export EDITOR=nvim
alias ll='eza -AhlT -L=1 -s=extension --group-directories-first --icons --git --git-ignore'
alias la='eza -Ah -s=extension --group-directories-first --icons'
alias vi=nvim
alias g=git

[ -f ~/.config/shell/local.sh ] && . ~/.config/shell/local.sh

# local.sh may prepend paths; keep PATH unique (bash has no typeset -U)
PATH=$(printf %s "$PATH" | awk -v RS=: '!a[$0]++{printf "%s%s",(NR>1?":":""),$0}')
